# Copy this file to `.env` when you want to customize local Docker settings.

# Used to sign login tokens in the FastAPI app.
SECRET_KEY=change-me-for-real-use

# Inside Docker, this path points at the mounted volume so SQLite data survives rebuilds.
DB_PATH=/app/data/app.db

# One World Relief payment settings.
# Use your Stripe Dashboard keys. Keep real secret keys out of Git.
OWR_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
OWR_STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
OWR_SUCCESS_URL=http://localhost:8000/charity/thank-you
OWR_CANCEL_URL=http://localhost:8000/charity/cancelled

# Optional PayPal settings if you want PayPal enabled.
OWR_PAYPAL_CLIENT_ID=
OWR_PAYPAL_CLIENT_SECRET=
OWR_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional admin key for donation reports and receipt lookup endpoints.
OWR_ADMIN_API_KEY=change-me-for-admin-reports
